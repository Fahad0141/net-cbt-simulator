{
  "name": "net-cbt-simulator",
  "version": "1.0.0",
  "homepage": "https://fahad0141.github.io/net-cbt-simulator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fahad0141/net-cbt-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/Fahad0141/net-cbt-simulator/issues"
  },
  "private": true,
  "description": "Unofficial, open-source NUST Entry Test (NET) computer-based test simulator with a hybrid dynamic question engine that generates unique full-length papers.",
  "keywords": [
    "nust",
    "net",
    "entry-test",
    "cbt",
    "mock-test",
    "exam-simulator",
    "question-generator",
    "pakistan"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bank": "vitest run --project unit src/bank",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "bank:report": "vite-node scripts/bank-report.ts",
    "paper": "vite-node scripts/generate-paper.ts --",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sample": "vite-node scripts/sample.ts --",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/android-assets.mjs && npx @capacitor/assets@3.0.5 generate --android",
    "android:smoke": "node scripts/android-smoke.mjs",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:dev": "npm run build && npm --prefix desktop start",
    "desktop:dist": "npm run build && npm --prefix desktop run dist",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@capacitor/status-bar": "7.0.6",
    "katex": "0.16.47",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vitest": "3.2.7"
  }
}
